{
  "name": "kcode",
  "version": "0.1.0",
  "description": "Offline AI-powered code editor based on VSCode with Ollama integration.",
  "private": true,
  "main": "./out/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/kcode/kcode.git"
  },
  "author": "KCode Team",
  "license": "MIT",
  "scripts": {
    "postinstall": "yarn compile:tailwind",
    "compile": "yarn run gulp compile",
    "compile:modules": "tsc -p scripts/tsconfig.json",
    "compile:tailwind": "node scripts/build-tailwind.js",
    "watch": "tsc -w -p scripts/tsconfig.json",
    "package": "yarn run gulp package",
    "package --linux": "yarn run gulp package-linux",
    "package --mac": "yarn run gulp package-mac",
    "package --win": "yarn run gulp package-win",
    "dist:linux": "electron-builder --linux --config build/electron-builder.json",
    "dist:mac": "electron-builder --mac --config build/electron-builder.json",
    "dist:win": "electron-builder --win --config build/electron-builder.json",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/state": "^6.3.1",
    "@codemirror/view": "^6.22.0",
    "@types/node": "^20.11.25",
    "@webcontainer/api": "^1.1.6",
    "axios": "^1.6.7",
    "electron": "^28.2.0",
    "framer-motion": "^11.0.3",
    "monaco-editor": "^0.45.0",
    "node-fetch": "^3.3.2",
    "ollama": "^0.1.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-toastify": "^10.0.4",
    "sqlite3": "^5.1.6",
    "simple-git": "^3.20.0",
    "tailwindcss": "^3.4.1",
    "vscode-extension-telemetry": "^0.9.7"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "electron-builder": "^24.6.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "gh-pages": "^6.0.0",
    "postcss": "^8.4.32",
    "postcss-loader": "^7.3.3",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "style-loader": "^3.3.4",
    "tailwindcss-jit": "^0.1.18",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "resolutions": {
    "vscode": "1.86.0"
  }
}
