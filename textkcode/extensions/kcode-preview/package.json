{
  "name": "kcode.kcode-preview",
  "displayName": "KCode Preview",
  "description": "Dockable WebContainers-powered preview pane with AI guidance",
  "version": "0.1.0",
  "publisher": "kcode",
  "engines": {
    "vscode": "^1.86.0"
  },
  "main": "dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "kcode-preview-container",
          "title": "Preview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "kcode-preview-container": [
        {
          "id": "kcodePreviewView",
          "name": "Web Preview"
        }
      ]
    },
    "commands": [
      {
        "command": "kcode-preview.open",
        "title": "Open KCode Preview"
      },
      {
        "command": "kcode-preview.deploy",
        "title": "KCode Preview: Deploy Current Workspace"
      },
      {
        "command": "kcode.netlify.saveToken",
        "title": "KCode Preview: Save Netlify Token"
      },
      {
        "command": "kcode.netlify.deploy",
        "title": "KCode Preview: Deploy with Netlify"
      },
      {
        "command": "kcode.vercel.deploy",
        "title": "KCode Preview: Deploy with Vercel"
      },
      {
        "command": "kcode.githubPages.deploy",
        "title": "KCode Preview: Deploy to GitHub Pages"
      }
    ]
  },
  "activationEvents": [
    "onCommand:kcode-preview.open",
    "onCommand:kcode-preview.deploy",
    "onCommand:kcode.netlify.saveToken",
    "onCommand:kcode.netlify.deploy",
    "onCommand:kcode.vercel.deploy",
    "onCommand:kcode.githubPages.deploy",
    "onView:kcodePreviewView",
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && webpack --mode production",
    "dev": "tsc -w -p tsconfig.json"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^2.4.0"
  }
}
