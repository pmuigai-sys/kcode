{
  "name": "kitana-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "nodemon --watch server --ext js,ts,json server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "lint": "eslint \"{src,server}/**/*.{ts,tsx,js}\" --max-warnings=0",
    "format": "prettier --write .",
    "db:reset": "node server/db/migrate.js --reset",
    "postinstall": "node scripts/copy-vendors.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.51.1",
    "adm-zip": "^0.5.12",
    "archiver": "^6.0.2",
    "axios": "^1.7.2",
    "body-parser": "^1.20.3",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fast-glob": "^3.3.2",
    "html2pdf.js": "^0.10.1",
    "marked": "^12.0.2",
    "monaco-editor": "^0.53.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
